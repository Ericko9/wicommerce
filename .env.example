# Node Environment
NODE_ENV=development
PORT=3000

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ucp_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-prod"
ENCRYPTION_SECRET_KEY="super-secret-encryption-key-for-db-at-rest"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Object Storage (S3 / MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="ucp-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Payment Gateways (Sandbox Default)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
XENDIT_SECRET_KEY="xnd_development_xxx"

# Frontend Connections
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN="ucp.local"
